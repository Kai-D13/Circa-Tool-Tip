# Copy sang .env.local (không commit) và điền giá trị thật từ Supabase Dashboard.
# Chỉ có HAI biến. Portal không bao giờ cần secret key, service-role key hay database
# password: mọi quyền ghi đi qua RPC security-definer được RLS + is_admin() bảo vệ.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
